# Copied to backend/.env by setup; start loads it without overriding exported variables.
# Never put this key in frontend/VITE_* variables. Keep .env private.
MODEL_API_KEY=

# Optional bounded sequential audit calls (no automatic retries).
INSPECTOR_MAX_AUDIT_REQUESTS=4
INSPECTOR_BATCH_BYTES=24000

# Sprint 9.2: operator budgets; 12288 is blocked pending hosted model documentation.
INSPECTOR_MAX_OUTPUT_TOKENS=8192
INSPECTOR_OUTPUT_TOKEN_CEILING=8192
# Additional conservative recovery reservations, never automatic retries.
INSPECTOR_MAX_RECOVERIES_PER_BATCH=2
INSPECTOR_MAX_RECOVERIES_PER_REVIEW=4

# Both API and MCP must authorize the same IDs and absolute repository roots.
INSPECTOR_REPOSITORIES={}
# Optional absolute path; default: backend/.local/reviews.sqlite3
# INSPECTOR_DB_PATH=/absolute/path/to/reviews.sqlite3
INSPECTOR_API_URL=http://127.0.0.1:8000
INSPECTOR_WEB_URL=http://127.0.0.1:5173
